<resources xmlns:tools="http://schemas.android.com/tools">    
    <!-- অ্যাপের মূল থিম -->
    <style name="Theme.NeoConnect" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
    </style>

    <!-- স্প্ল্যাশ স্ক্রিনের জন্য আলাদা থিম (এটাই ম্যাজিক করবে) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- ব্যাকগ্রাউন্ড কালার -->
        <item name="windowSplashScreenBackground">@color/splash_bg</item>        
        <!-- লোগো আইকন (এটা একদম শুরুতেই দেখাবে) -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>        
        <!-- অ্যানিমেশনের সময় (মিলিসেকেন্ড) -->
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="s">1000</item>        
        <!-- স্প্ল্যাশ শেষে অ্যাপের আসল থিমে চলে যাবে -->
        <item name="postSplashScreenTheme">@style/Theme.NeoConnect</item>
    </style>
</resources>