<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.NeoConnect" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- স্প্যাশ স্ক্রিনের জন্য ব্যাকগ্রাউন্ড কালার -->
        <item name="android:windowBackground">@color/splash_bg</item>
        <!-- Status Bar এবং Navigation Bar কালার -->
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        
        <!-- Android 12+ এর জন্য ডিফল্ট লোগো আইকন বন্ধ করে দিচ্ছি -->
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/splash_bg</item>
    </style>
</resources>